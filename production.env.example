# Production Compose interpolation template. Copy to production.env on the VM,
# fill required values there, and keep production.env out of Git.

# Required for GHCR image references; use the lowercase GitHub owner/package namespace.
GHCR_OWNER=
# Required immutable tag (for example a commit SHA); no latest fallback is used.
IMAGE_TAG=

# Required PostgreSQL settings. Keep these values private on the VM.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required application connection string; use postgres:5432 as its host and port.
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=

# Optional application settings.
JWT_EXPIRES_IN=8h
SEED_ON_START=false

# Optional host loopback port consumed by the VM reverse proxy.
FRONTEND_PORT=8080
